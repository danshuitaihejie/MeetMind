# Default example: use MiniMax for both speech recognition and text.
MINIMAX_API_KEY=

# Mainland China API host and models. For an international account, use
# https://api.minimax.io as the base URL.
MEETMIND_MINIMAX_BASE_URL=https://api.minimaxi.com
MEETMIND_TRANSCRIPTION_MODEL=asr-1.0
MEETMIND_SUMMARY_MODEL=MiniMax-M2.7

# Optional: replace either service with an OpenAI-compatible endpoint.
# Configure each custom service with its own URL and key. URLs may end in /v1.
# The ASR service must support audio/transcriptions; word-level review also
# requires verbose_json with timestamp_granularities[]=word and a words array.
# MEETMIND_ASR_API_KEY=
# MEETMIND_ASR_BASE_URL=https://speech.example.com/v1
# MEETMIND_ASR_API_FORMAT=openai
# MEETMIND_TRANSCRIPTION_MODEL=your-asr-model
# MEETMIND_TEXT_API_KEY=
# MEETMIND_TEXT_BASE_URL=https://chat.example.com/v1
# MEETMIND_TEXT_API_FORMAT=openai
# MEETMIND_SUMMARY_MODEL=your-chat-model
# MEETMIND_TEXT_MAX_TOKENS_FIELD=max_tokens

# Local storage and upload limit.
MEETMIND_DATA_DIR=./data
MEETMIND_MAX_UPLOAD_MB=2048
